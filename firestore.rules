rules_version = '2';
// ═══════════════════════════════════════════════════════════
//  Oreon Cronograma — Regras de segurança do Firestore
// ═══════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Dados do usuário (só ele mesmo acessa) ──────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Subcoleções de obras
      match /projetos/{obraId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        // Equipe sem login pode gravar APENAS campos de envio semanal
        allow update: if (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['semanaUltimoEnvio', 'enviosSemana'])
        );
      }
    }

    // ── Links semanais de preenchimento (sem login) ─────────
    match /links/{token} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null &&
                       request.auth.uid == resource.data.ownerUid;
      allow update: if (
        (request.auth != null && request.auth.uid == resource.data.ownerUid) ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['envios', 'usado']) &&
          resource.data.expiresAt > request.time
        )
      );
    }
  }
}
